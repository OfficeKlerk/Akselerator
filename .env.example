# Скопировать в .env на сервере. Локально всё работает и без этого файла.
SECRET_KEY=          # длинная случайная строка: openssl rand -hex 32
POSTGRES_PASSWORD=
COOKIE_SECURE=true   # сайт открыт по HTTPS
NSPD_PROXY=          # http://user:pass@host:port — прокси с российским IP для запросов к НСПД
